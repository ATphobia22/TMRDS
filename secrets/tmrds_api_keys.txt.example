# Copy to tmrds_api_keys.txt on the deployment host. One 'key_id:sha256(secret)' per line.
# Generate: python -c "import secrets,hashlib; s=secrets.token_urlsafe(32); print('doc001:'+hashlib.sha256(s.encode()).hexdigest()); print('HAND OUT: tmrds_doc001_'+s)"
# Never commit the real file.
doc001:REPLACE_WITH_SHA256_HEX_OF_SECRET
