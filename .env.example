# Safe local placeholders only. Replace values in an untracked .env file.
POSTGRES_DB=tmrds
POSTGRES_USER=tmrds
POSTGRES_PASSWORD=replace-with-local-only-password
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-only-password
TMRDS_ENV=development
TMRDS_BASE_URL=http://127.0.0.1:8000
TMRDS_US_CORE_VERSION=8.0.0
TMRDS_HMAC_SECRET=replace-with-random-secret
TMRDS_CLINICIAN_PASSWORD=replace-with-local-only-password
TMRDS_EMERGENCY_PIN=replace-with-local-only-pin
TMRDS_DATABASE_URL=postgresql://tmrds:replace-with-local-only-password@tmrds-postgres:5432/tmrds # example.invalid
TMRDS_NEO4J_URI=bolt://tmrds-neo4j:7687
TMRDS_NEO4J_USER=neo4j
TMRDS_NEO4J_PASSWORD=replace-with-local-only-password
TMRDS_SERVICE_AUTH_REQUIRED=false
TMRDS_SERVICE_ISSUER=https://example.invalid/issuer
TMRDS_SERVICE_AUDIENCE=tmrds-local
TMRDS_SERVICE_JWKS_JSON={"keys":[]}
TMRDS_API_BIND=127.0.0.1
TMRDS_API_HOST_PORT=8000

# --- Observability overlay (docker-compose.obs.yml) ---
TMRDS_PUBLIC_HOST=tmrds.example.com
TMRDS_AUTH_HOST=auth.example.com
GRAFANA_ADMIN_USER=admin
KEYCLOAK_ADMIN_USER=admin
# Secrets below live in ./secrets/*.txt (gitignored); copy from *.example first.
# GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin_password
# KC_DB_PASSWORD_FILE=/run/secrets/keycloak_db_password
# KC_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/keycloak_admin_password
# Optional API-key gate: set to /run/secrets/tmrds_api_keys and mount the secret
# to enable key-gating on /api/* (see runbook). Unset = open.
# TMRDS_API_KEYS_FILE=/run/secrets/tmrds_api_keys
